{
  "type": "object",
  "required": ["id", "name", "full_name", "owner", "private", "html_url", "url"],
  "properties": {
    "id":        { "type": "integer" },
    "name":      { "type": "string" },
    "full_name": { "type": "string" },
    "private":   { "type": "boolean" },
    "html_url":  { "type": "string" },
    "url":       { "type": "string" },
    "description": { "type": ["string", "null"] },
    "auto_init": { "type": ["boolean", "null"] },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "owner": {
      "type": "object",
      "required": ["login", "id"],
      "properties": {
        "login": { "type": "string" },
        "id":    { "type": "integer" }
      }
    }
  }
}