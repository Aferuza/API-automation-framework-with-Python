{
  "type": "object",
  "required": ["id", "name", "full_name", "owner", "html_url", "url", "private", "default_branch"],
  "properties": {
    "id":             { "type": "integer" },
    "name":           { "type": "string" },
    "full_name":      { "type": "string" },
    "private":        { "type": "boolean" },
    "html_url":       { "type": "string" },
    "url":            { "type": "string" },
    "description":    { "type": ["string", "null"] },
    "default_branch": { "type": "string" },
    "owner": {
      "type": "object",
      "required": ["login", "id", "type"],
      "properties": {
        "login": { "type": "string" },
        "id":    { "type": "integer" },
        "type":  { "type": "string" }
      }
    }
  }
}
